{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/interaction-map.schema.json",
  "title": "Chemistry Interaction Map",
  "type": "object",
  "required": ["simulations"],
  "properties": {
    "simulations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "section_id",
          "scientific_model",
          "controls",
          "outputs",
          "invariant",
          "reset_state"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "section_id": {"type": "string", "minLength": 1},
          "scientific_model": {
            "type": "object",
            "required": ["equation", "assumptions", "oracle"],
            "properties": {
              "equation": {"type": "string", "minLength": 1},
              "assumptions": {"type": "array", "items": {"type": "string"}},
              "oracle": {"type": "string", "minLength": 1},
              "relative_tolerance": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": true
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label_ar", "variable", "unit", "min", "max", "step", "default"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "label_ar": {"type": "string", "minLength": 1},
                "variable": {"type": "string", "minLength": 1},
                "unit": {"type": "string"},
                "min": {"type": "number"},
                "max": {"type": "number"},
                "step": {"type": "number", "exclusiveMinimum": 0},
                "default": {"type": "number"},
                "validation": {"type": "object"}
              },
              "additionalProperties": true
            }
          },
          "outputs": {"type": "array", "items": {"type": "object"}},
          "visual_mapping": {"type": "array", "items": {"type": "object"}},
          "invariant": {
            "type": "object",
            "required": ["label_ar", "expression"],
            "properties": {
              "label_ar": {"type": "string", "minLength": 1},
              "expression": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "reset_state": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
