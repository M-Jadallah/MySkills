{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/lesson-content-map.schema.json",
  "title": "Chemistry Lesson Content Map",
  "type": "object",
  "required": ["lesson", "sections"],
  "properties": {
    "lesson": {
      "type": "object",
      "required": ["id", "title_ar", "main_idea_ar", "learning_outcomes_ar"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title_ar": {"type": "string", "minLength": 1},
        "main_idea_ar": {"type": "string", "minLength": 1},
        "learning_outcomes_ar": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "source_files": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_ar",
          "objective_ar",
          "explanation_ar",
          "terms",
          "equations",
          "interaction",
          "verification",
          "accessibility_summary_ar"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title_ar": {"type": "string", "minLength": 1},
          "objective_ar": {"type": "string", "minLength": 1},
          "prerequisites_ar": {"type": "array", "items": {"type": "string"}},
          "explanation_ar": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "terms": {"type": "array", "items": {"type": "object"}},
          "equations": {"type": "array", "items": {"type": "object"}},
          "source_visuals": {"type": "array", "items": {"type": "object"}},
          "interaction": {"type": "object"},
          "verification": {"type": "object"},
          "worked_examples": {"type": "array", "items": {"type": "object"}},
          "quick_checks": {"type": "array", "items": {"type": "object"}},
          "misconceptions_ar": {"type": "array", "items": {"type": "string"}},
          "transition_ar": {"type": "string"},
          "accessibility_summary_ar": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
