  "summary": [
    {
      "id": "s1",
      "kind": "bullet",
      "text": [
        {
          "text": "أَقْسَامُ الْكَلِمَةِ: ",
          "bold": true
        },
        {
          "text": "اِسْمٌ، وَفِعْلٌ، وَحَرْفٌ."
        }
      ]
    },
    {
      "id": "s2",
      "kind": "bullet",
      "text": "مِثَالُ الِاسْمِ: كِتَابٌ، وَمِثَالُ الْحَرْفِ: فِي."
    },
    {
      "id": "s3",
      "kind": "bullet",
      "text": [
        {
          "text": "أَقْسَامُ الْفِعْلِ: ",
          "bold": true
        },
        {
          "text": "مَاضٍ، وَمُضَارِعٌ، وَأَمْرٌ."
        }
      ]
    },
    {
      "id": "s4",
      "kind": "bullet",
      "text": "أَمْثِلَةُ أَقْسَامِ الْفِعْلِ عَلَى التَّرْتِيبِ: كَتَبَ، يَكْتُبُ، اُكْتُبْ."
    },
    {
      "id": "s5",
      "kind": "bullet",
      "text": "الْمَاضِي يَدُلُّ عَلَى حَدَثٍ قَبْلَ زَمَنِ التَّكَلُّمِ."
    },
    {
      "id": "s6",
      "kind": "bullet",
      "text": "الْمُضَارِعُ يَدُلُّ عَلَى حَدَثٍ فِي الْحَالِ أَوِ الِاسْتِقْبَالِ."
    },
    {
      "id": "s7",
      "kind": "bullet",
      "text": "الْأَمْرُ يَدُلُّ عَلَى طَلَبِ حُدُوثِ الْفِعْلِ."
    }
  ],
